{
  "name": "pokemon-emerald-horizons-offline-mobile",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 4173",
    "build": "next build --webpack",
    "test": "node --test tests/*.test.mjs",
    "test:original": "tsx --test tests/original/*.test.ts",
