{
  "name": "pokemon-emerald-horizons-offline-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 4173",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "build:game": "powershell -ExecutionPolicy Bypass -File scripts/build-game.ps1",
    "build:android": "powershell -ExecutionPolicy Bypass -File scripts/build-game.ps1 -AndroidOnly",
    "build:web": "powershell -ExecutionPolicy Bypass -File scripts/build-game.ps1 -WebOnly",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/vt323": "5.3.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
