[node name="NPC_OldManAwake" parent="NPCs" unique_id=914822461 instance=ExtResource("7")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -5, 0, -189)
npc_name = "Old Man"
sprite_sheet = ExtResource("8")
lines = PackedStringArray("Well, now, I\'ve had my coffee, and\nthat\'s what I need to get going!", "Hm?\nWhat is that red box you have?", "Ah, so you\'re working on your\nPOKéDEX.", "Then let me give you a word of\nadvice.", "Whenever you catch a POKéMON,\nthe POKéDEX automatically updates\nits data.", "…You don\'t know how to catch\na POKéMON?", "I suppose I had better show you\nthen!")
action = 3
start_facing = 2
requires_flag = "has_pokedex"

[node name="NPC_GranddaughterAwake" parent="NPCs" unique_id=2054725265 instance=ExtResource("7")]
